# Versions used for local builds and as defaults. The CI overrides these
# per run (see .github/workflows/build.yml).

# Latest tagged ComfyUI release (without leading v). The CI overrides
# this from the upstream API; this is the fallback for local builds.
COMFYUI_VERSION=0.34.0

# uv version baked into the image. 0.12.5 matches comfyui-cuda and is
# known to handle --extra-index-url correctly in requirements files.
# Versions ≤ 0.5.x have a bug that mis-parses the directive as a
# package URL.
UV_VERSION=0.12.5

# Python version for the venv. The ROCm base image ships without
# Python; uv installs it. 3.13 is supported by all current
# torch/torchvision/torchaudio +rocm7.2 wheels.
PYTHON_VERSION=3.13

# Image name. Override locally with `IMAGE=...` in your shell if you
# push to a different registry.
IMAGE=ghcr.io/genesis-scaffolding/comfyui-rocm

# Default ROCm version for local builds. Matches the tag baked into
# rocm/dev-ubuntu-24.04:<ROCM_VERSION>. 7.2.4 is the most recent
# release that ships gfx1201 (RDNA 4 / R9700) support out of the box.
ROCM_VERSION=7.2.4

# Ubuntu version of the base image. The rocm/dev-ubuntu-24.04 line
# only has 24.04 tags, so this is informational today. Kept for
# parity with the cuda image's metadata.env shape.
UBUNTU_VERSION=24.04
