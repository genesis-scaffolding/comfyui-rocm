# Versions used for local builds and as defaults. The CI overrides these
# per run (see .github/workflows/build.yml).

# Latest tagged ComfyUI release (without leading v). The CI overrides
# this from the upstream API; this is the fallback for local builds.
COMFYUI_VERSION=0.34.0

# uv version baked into the image. 0.12.5 matches comfyture and is
# known to handle --extra-index-url correctly in requirements files.
# Versions ≤ 0.5.x have a bug that mis-parses the directive as a
# package URL.
UV_VERSION=0.12.5

# Image name. Override locally with `IMAGE=...` in your shell if you
# push to a different registry.
IMAGE=ghcr.io/genesis-scaffolding/comfyui-rocm

# The rocm/pytorch tag to base on. Encodes ROCm + Ubuntu + Python +
# PyTorch versions. See https://hub.docker.com/r/rocm/pytorch/tags
# for the full list.
# 7.2.4 is the most recent public release that supports gfx1201 (RDNA 4
# / R9700) out of the box. Nightly `device-all` multi-arch tags exist
# but are tagged RELEASE_TYPE=nightly and not recommended for stable
# builds.
ROCM_BASE_TAG=rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.9.1
